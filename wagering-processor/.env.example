# PostgreSQL running from docker-compose on the host
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering
PORT=3000
MIKRO_ORM_DEBUG=false

# LocalStack SQS. Keep disabled for local HTTP-only development.
SQS_ENABLED=true
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_REQUEST_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events

# Optional observability vendor credentials; not required for local operation.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
