{
  "name": "wagering-processor",
  "version": "0.0.1",
  "description": "Distributed wagering processor with exact money, PostgreSQL locking, Inbox/Outbox and SQS.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/src/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "migration:create": "mikro-orm migration:create --config ./mikro-orm.config.ts",
    "migration:up": "mikro-orm migration:up --config ./mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config ./mikro-orm.config.ts",
    "test:unit": "bun test src/domain",
    "test:integration": "bun test test/integration",
    "test:sqs": "bun test test/integration/sqs.integration.spec.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@aws-sdk/client-sqs": "^3.800.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "@types/bun": "^1.2.0"
  }
}
